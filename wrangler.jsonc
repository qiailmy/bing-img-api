{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bing-img-api",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    { "binding": "BING_IMAGES", "bucket_name": "ailmy" }
  ],
  "triggers": {
    "crons": ["0 22 * * *"]
  }
}
